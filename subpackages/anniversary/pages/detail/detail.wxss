/* pages/detail/detail.wxss */
.container {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.detail-card {
  background: rgba(255, 255, 255, 0.95);
  width: 100%;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.header {
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.actions {
  position: absolute;
  right: 0;
  top: 10rpx;
}

.edit-btn {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.05);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.edit-btn:active {
  background: rgba(0, 0, 0, 0.1);
}

.edit-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  color: #666;
  line-height: 1;
}

.action-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1;
}

.main-display {
  text-align: center;
  margin-bottom: 60rpx;
}

.label {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.days-container {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.days {
  font-size: 120rpx;
  font-weight: bold;
  color: #333;
  line-height: 1;
}

.unit {
  font-size: 32rpx;
  color: #666;
  margin-left: 10rpx;
}

.progress-bar {
  width: 80%;
  margin: 30rpx auto 0;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.footer-info {
  text-align: center;
  margin-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-info {
  display: block;
  font-size: 36rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.type-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.reminder-btn {
  padding: 10rpx 30rpx;
  border: 1rpx solid #333;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #333;
}

.share-btn {
  background: #333;
  color: #fff;
  border-radius: 50rpx;
  padding: 0 60rpx;
  font-size: 30rpx;
}
