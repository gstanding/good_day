/* pages/edit/edit.wxss */
.container {
  padding: 30rpx;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 0 24rpx;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
}

.input {
  text-align: right;
  font-size: 30rpx;
}

.picker {
  font-size: 30rpx;
  color: #666;
}

.radio-group {
  display: flex;
}

.radio-item {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  color: #666;
}

.radio-item.active {
  background: var(--primary-color);
  color: #fff;
}

.color-options {
  display: flex;
}

.color-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-left: 20rpx;
  border: 4rpx solid transparent;
}

.color-circle.selected {
  border-color: #333;
}

.form-item-photo {
  align-items: flex-start;
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}

.photo-picker-area {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.photo-preview-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-preview {
  width: 100rpx;
  height: 100rpx;
}

.photo-placeholder {
  width: 100rpx;
  height: 100rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-plus {
  font-size: 44rpx;
  color: #bbb;
  line-height: 1;
}

.photo-hint {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.photo-remove {
  font-size: 24rpx;
  color: #ff4d4f;
}

.footer {
  margin-top: 60rpx;
}

.btn-delete {
  margin-top: 30rpx;
  background: #fff;
  color: #ff4d4f;
}
