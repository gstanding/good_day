<view class="container">

  <!-- Step: input -->
  <view wx:if="{{step === 'input'}}" class="input-page">
    <textarea class="main-textarea"
              placeholder="随手记下这个想法..."
              placeholder-style="color:#C7C7CC"
              value="{{rawInput}}"
              bindinput="onRawInput"
              auto-focus
              auto-height />
    <view class="input-actions">
      <view class="btn-ai" bindtap="aiOrganize">
        <text class="btn-ai-text">✨  AI 整理</text>
      </view>
      <view class="btn-skip" bindtap="quickSave">
        <text class="btn-skip-text">直接保存</text>
      </view>
    </view>
  </view>

  <!-- Step: loading -->
  <view wx:if="{{step === 'loading'}}" class="loading-page">
    <text class="loading-emoji">✨</text>
    <text class="loading-text">AI 正在整理...</text>
  </view>

  <!-- Step: preview -->
  <scroll-view wx:if="{{step === 'preview'}}" class="preview-page" scroll-y>

    <view class="raw-card">
      <text class="raw-label">原始内容</text>
      <text class="raw-text">{{rawInput}}</text>
      <text class="raw-edit" bindtap="backToInput">修改 ›</text>
    </view>

    <text class="field-label">标题</text>
    <input class="field-input"
           value="{{title}}"
           bindinput="onTitleInput"
           placeholder="请输入标题"
           placeholder-style="color:#C7C7CC"
           maxlength="60" />

    <text class="field-label">标签</text>
    <view class="tags-row">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-chip">
        <text class="tag-text"># {{item}}</text>
        <text class="tag-remove" bindtap="removeTag" data-index="{{index}}">×</text>
      </view>
      <input wx:if="{{tags.length < 5}}"
             class="tag-add-input"
             value="{{tagInput}}"
             placeholder="+ 添加"
             placeholder-style="color:#C7C7CC"
             bindinput="onTagInputChange"
             bindconfirm="onTagInputConfirm" />
    </view>

    <block wx:if="{{isEdit}}">
      <text class="field-label">状态</text>
      <view class="status-options">
        <view wx:for="{{statusOptions}}" wx:key="value"
              class="status-option {{status === item.value ? 'status-option-active' : ''}}"
              style="{{status === item.value ? 'background:' + item.color + ';' : ''}}"
              bindtap="onStatusSelect" data-status="{{item.value}}">
          <text class="status-option-text" style="color:{{status === item.value ? '#fff' : '#3C3C43'}}">
            {{item.label}}
          </text>
        </view>
      </view>
    </block>

    <view class="save-btn" bindtap="confirmSave">
      <text class="save-text">保存</text>
    </view>

  </scroll-view>

</view>
