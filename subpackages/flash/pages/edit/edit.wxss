/* subpackages/flash/pages/edit/edit.wxss */
page { background: #F2F2F7; }

.container { height: 100vh; }

.form {
  height: 100%;
  padding: 24rpx 32rpx 80rpx;
  box-sizing: border-box;
}

/* 统一表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.form-section {
  padding: 28rpx 32rpx 24rpx;
}

.form-section + .form-section {
  border-top: 1rpx solid #F2F2F7;
}

.field-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  margin-bottom: 14rpx;
}

.field-input {
  display: block;
  width: 100%;
  font-size: 32rpx;
  font-weight: 500;
  color: #1C1C1E;
  box-sizing: border-box;
  line-height: 1.4;
}

.field-textarea {
  display: block;
  width: 100%;
  font-size: 28rpx;
  color: #1C1C1E;
  min-height: 180rpx;
  box-sizing: border-box;
  line-height: 1.7;
}

/* 标签输入 */
.field-input-tags {
  display: block;
  width: 100%;
  font-size: 28rpx;
  color: #1C1C1E;
  box-sizing: border-box;
}

/* 标签 chips */
.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag-chip {
  padding: 8rpx 20rpx;
  background: rgba(99,102,241,0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #6366F1;
  font-weight: 500;
}

/* 状态选择（仅编辑模式） */
.status-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.status-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1.5rpx;
  margin-bottom: 20rpx;
}

.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-option {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.05);
}

.status-option-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 保存按钮 */
.save-btn {
  margin-top: 48rpx;
  background: #1C1C1E;
  border-radius: 24rpx;
  padding: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.18);
}

.save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}
