/* subpackages/flash/pages/edit/edit.wxss */
page {
  background: #F2EBDD;
  overflow-x: hidden;
}

/* ══════════════════════════════════════
   STEP: INPUT
══════════════════════════════════════ */
.input-page {
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  background: #F2EBDD;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

/* scrollable area between topbar and bottom actions */
.input-middle {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* faint horizontal-rule paper lines */
.paper-lines {
  position: absolute;
  inset: 0;
  opacity: 0.6;
  background-image: repeating-linear-gradient(
    transparent,
    transparent 63rpx,
    rgba(60,40,16,0.08) 63rpx,
    rgba(60,40,16,0.08) 65rpx
  );
  background-position-y: 280rpx;
  pointer-events: none;
  z-index: 0;
}

.input-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 36rpx 8rpx;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.close-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(60,40,16,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: #5C5247;
  line-height: 1;
  margin-top: -2rpx;
}

.input-timestamp {
  font-size: 24rpx;
  color: #897C6C;
  font-family: ui-monospace, monospace;
}

.input-prompt {
  padding: 48rpx 44rpx 24rpx;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.new-capsule-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F4E2D2;
  margin-bottom: 28rpx;
}

.new-capsule-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #A8542B;
  letter-spacing: 2.8rpx;
}

.input-question {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2B241B;
  line-height: 1.25;
  letter-spacing: -0.6rpx;
}

.main-textarea {
  min-height: 480rpx;
  padding: 12rpx 44rpx 40rpx;
  font-size: 34rpx;
  color: #2B241B;
  line-height: 64rpx;
  letter-spacing: 0.2rpx;
  box-sizing: border-box;
  width: 100%;
  background: transparent;
  position: relative;
  z-index: 1;
}

.input-bottom {
  position: relative;
  z-index: 1;
  padding: 20rpx 44rpx 60rpx;
  background: linear-gradient(to bottom, transparent, #F2EBDD 28%);
  flex-shrink: 0;
}

.input-meta-row {
  margin-bottom: 24rpx;
}

.char-count {
  font-size: 22rpx;
  color: #897C6C;
}

.input-actions {
  display: flex;
  gap: 20rpx;
}

.btn-ai {
  flex: 1;
  height: 104rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #A8542B 0%, #C77546 60%, #D88A4A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(168,84,43,0.3), 0 4rpx 8rpx rgba(168,84,43,0.4);
  position: relative;
  overflow: hidden;
}

.btn-ai::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.22), transparent 40%);
  pointer-events: none;
}

.btn-ai-spark {
  font-size: 30rpx;
  color: #fff;
}

.btn-ai-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.6rpx;
}

.btn-skip {
  width: 192rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(60,40,16,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-skip-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #5C5247;
}

/* ══════════════════════════════════════
   STEP: LOADING
══════════════════════════════════════ */
.loading-page {
  width: 100%;
  box-sizing: border-box;
  min-height: 100vh;
  background: #F2EBDD;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.loading-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
  padding: 0 64rpx;
}

.loading-ring-outer {
  width: 192rpx;
  height: 192rpx;
  border-radius: 999rpx;
  background: #F4E2D2;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 1.6s ease-out infinite;
}

.loading-ring-inner {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #A8542B 0%, #D88A4A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(168,84,43,0.4);
}

.loading-spark-icon {
  font-size: 48rpx;
  color: #fff;
}

.loading-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2B241B;
  text-align: center;
}

.loading-sub {
  font-size: 26rpx;
  color: #897C6C;
  text-align: center;
  line-height: 1.6;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #A8542B;
}

.dot-1 { animation: bob 1s ease-in-out 0s infinite; }
.dot-2 { animation: bob 1s ease-in-out 0.18s infinite; }
.dot-3 { animation: bob 1s ease-in-out 0.36s infinite; }

@keyframes pulse {
  0%   { transform: scale(0.9); opacity: 0.8; }
  100% { transform: scale(1.4); opacity: 0; }
}

@keyframes bob {
  0%,100% { transform: translateY(0);       opacity: 0.4; }
  50%      { transform: translateY(-8rpx);  opacity: 1; }
}

/* ══════════════════════════════════════
   STEP: PREVIEW
══════════════════════════════════════ */
.preview-page {
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  background: #F2EBDD;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
}

.preview-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 8rpx;
  flex-shrink: 0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(60,40,16,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #5C5247;
  line-height: 1;
  margin-top: -2rpx;
}

.ai-done-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #F4E2D2;
}

.ai-done-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #A8542B;
  letter-spacing: 2rpx;
}

.preview-scroll {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 44rpx 0;
}

/* quoted raw input */
.quoted-block {
  display: flex;
  gap: 0;
  margin-bottom: 44rpx;
}

.quote-bar {
  width: 4rpx;
  border-radius: 2rpx;
  background: #A8542B;
  flex-shrink: 0;
  margin-right: 28rpx;
  min-height: 48rpx;
}

.quote-content {
  flex: 1;
}

.quote-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: #897C6C;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.quote-body-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.quote-text {
  flex: 1;
  font-size: 26rpx;
  color: #5C5247;
  line-height: 1.55;
}

.quote-edit-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: #A8542B;
  flex-shrink: 0;
}

/* section labels */
.preview-section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #897C6C;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

/* title input */
.preview-title-input {
  display: block;
  width: 100%;
  height: 80rpx;
  padding: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: #2B241B;
  letter-spacing: -0.4rpx;
  box-sizing: border-box;
}

.title-divider {
  height: 2rpx;
  background: rgba(60,40,16,0.12);
  margin-top: 8rpx;
}

/* tags row */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(60,40,16,0.12);
  border-radius: 999rpx;
  padding: 12rpx 20rpx 12rpx 24rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #5C5247;
  font-weight: 500;
}

.tag-remove {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: rgba(60,40,16,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-remove-icon {
  font-size: 24rpx;
  color: #897C6C;
  line-height: 1;
}

.tag-add-wrap {
  border: 2rpx dashed rgba(60,40,16,0.12);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.tag-add-input {
  display: block;
  height: 48rpx;
  padding: 0;
  font-size: 24rpx;
  color: #2B241B;
  min-width: 100rpx;
}

/* status tiles */
.status-tiles {
  display: flex;
  gap: 16rpx;
}

.status-tile {
  flex: 1;
  padding: 20rpx 8rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tile-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
}

.tile-label {
  font-size: 22rpx;
  font-weight: 600;
}

/* save button */
.preview-save-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 44rpx 64rpx;
  background: linear-gradient(to bottom, transparent, #F2EBDD 28%);
}

.save-btn {
  background: #1E1812;
  border-radius: 32rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(60,40,16,0.18);
}

.save-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.8rpx;
}
