/* subpackages/flash/pages/edit/edit.wxss */
page { background: #F4F4F6; }

.container { height: 100vh; position: relative; }

/* ── input page ── */
.input-page {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

.main-textarea {
  flex: 1;
  min-height: 400rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #1C1C1E;
  box-sizing: border-box;
  width: 100%;
}

.input-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn-ai {
  flex: 2;
  background: #1C1C1E;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-ai-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.btn-skip {
  flex: 1;
  background: rgba(0,0,0,0.06);
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-skip-text {
  font-size: 26rpx;
  color: #3C3C43;
}

/* ── loading page ── */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 24rpx;
}

.loading-emoji {
  font-size: 88rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #8E8E93;
}

/* ── preview page ── */
.preview-page {
  height: 100%;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.raw-card {
  background: rgba(0,0,0,0.03);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 4rpx;
  position: relative;
}

.raw-label {
  display: block;
  font-size: 20rpx;
  color: #C7C7CC;
  margin-bottom: 8rpx;
}

.raw-text {
  display: block;
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.6;
  padding-right: 80rpx;
}

.raw-edit {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 24rpx;
  color: #6366F1;
}

/* shared field styles */
.field-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #8E8E93;
  letter-spacing: 1rpx;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
}

.field-input {
  display: block;
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1C1C1E;
  box-sizing: border-box;
}

/* tags row */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
}

.tag-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(99,102,241,0.1);
  border-radius: 20rpx;
  padding: 10rpx 18rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #6366F1;
}

.tag-remove {
  font-size: 30rpx;
  color: #6366F1;
  line-height: 1;
}

.tag-add-input {
  background: rgba(0,0,0,0.04);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #1C1C1E;
  min-width: 120rpx;
}

/* status options */
.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-option {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.05);
}

.status-option-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* save button */
.save-btn {
  margin-top: 60rpx;
  background: #1C1C1E;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* ── API Key mask ── */
.api-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.api-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 600rpx;
  box-sizing: border-box;
}

.api-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.api-hint {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 32rpx;
}

.api-input {
  background: #F4F4F6;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.api-actions {
  display: flex;
  gap: 20rpx;
}

.api-cancel {
  flex: 1;
  background: rgba(0,0,0,0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
}

.api-confirm {
  flex: 2;
  background: #1C1C1E;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
}

.api-cancel-text {
  font-size: 28rpx;
  color: #3C3C43;
}

.api-confirm-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
