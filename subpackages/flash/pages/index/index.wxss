/* subpackages/flash/pages/index/index.wxss */
page {
  background: #F2EBDD;
  overflow-x: hidden;
}

.page {
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F2EBDD;
  overflow-x: hidden;
}

/* ── module header ── */
.module-header {
  padding: 16rpx 44rpx 28rpx;
  flex-shrink: 0;
}

.module-badge-row {
  margin-bottom: 12rpx;
}

.module-badge-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4.8rpx;
  color: #A8542B;
}

.header-tagline {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2B241B;
  letter-spacing: -0.8rpx;
  line-height: 1.25;
  margin-bottom: 20rpx;
}

.header-meta {
  font-size: 26rpx;
  color: #897C6C;
}

.header-count {
  color: #2B241B;
  font-weight: 600;
}

/* ── search ── */
.search-wrap {
  margin: 0 44rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(60,40,16,0.06);
  box-shadow: 0 1rpx 0 rgba(60,40,16,0.04), 0 4rpx 14rpx rgba(60,40,16,0.05);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.search-icon-text {
  font-size: 34rpx;
  color: #897C6C;
  line-height: 1;
}

.search-input {
  display: block;
  height: 44rpx;
  padding: 0;
  font-size: 28rpx;
  color: #2B241B;
  flex: 1;
}

/* ── tab bar ── */
.tab-bar {
  flex-shrink: 0;
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.tab-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 44rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(60,40,16,0.12);
  background: transparent;
}

.tab-active {
  background: #1E1812;
  border-color: #1E1812;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #5C5247;
}

.tab-active .tab-label {
  color: #FFFFFF;
}

.tab-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #B5A993;
}

.tab-active .tab-count {
  color: rgba(255,255,255,0.55);
}

/* ── card list ── */
.list {
  flex: 1;
  overflow: hidden;
}

/* ── empty state ── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B241B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #897C6C;
  text-align: center;
  line-height: 1.6;
  padding: 0 60rpx;
}

/* ── group header ── */
.group-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 44rpx 16rpx;
}

.group-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #897C6C;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.group-sep {
  font-size: 22rpx;
  color: #B5A993;
}

.group-line {
  flex: 1;
  height: 1rpx;
  background: rgba(60,40,16,0.08);
  margin-left: 8rpx;
}

/* ── group cards ── */
.group-cards {
  padding: 0 44rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

/* ── card ── */
.card {
  width: 100%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid rgba(60,40,16,0.06);
  box-shadow: 0 1rpx 0 rgba(60,40,16,0.04), 0 4rpx 14rpx rgba(60,40,16,0.05);
  display: flex;
  overflow: hidden;
}

.card-rail {
  width: 6rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  margin: 28rpx 0 28rpx 28rpx;
}

.card-body {
  flex: 1;
  padding: 28rpx 32rpx 28rpx 24rpx;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2B241B;
  line-height: 1.35;
  flex: 1;
  letter-spacing: -0.2rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 18rpx 6rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.status-pill-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.card-content {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  color: #5C5247;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}

.card-tag {
  font-size: 22rpx;
  color: #897C6C;
  background: #EEE6D5;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.card-time {
  font-size: 22rpx;
  color: #B5A993;
  flex-shrink: 0;
}

/* ── FAB ── */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: 80rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #1E1812;
  border-radius: 999rpx;
  padding: 24rpx 36rpx 24rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(60,40,16,0.25), 0 4rpx 12rpx rgba(60,40,16,0.12);
}

.fab-plus {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-plus-icon {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}

.fab-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.6rpx;
}
