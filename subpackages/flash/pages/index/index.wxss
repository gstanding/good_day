/* subpackages/flash/pages/index/index.wxss */
page { background: #F4F4F6; }

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 搜索框 */
.search-bar {
  padding: 20rpx 32rpx 16rpx;
  background: #F4F4F6;
  flex-shrink: 0;
}

.search-wrap {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon { font-size: 28rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  height: 40rpx;
}

/* 状态 Tab */
.tab-bar {
  white-space: nowrap;
  padding: 0 24rpx 20rpx;
  flex-shrink: 0;
}

.tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
  background: rgba(0,0,0,0.05);
}

.tab-active {
  background: #1C1C1E;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8E8E93;
}

.tab-active .tab-text {
  color: #fff;
}

/* 卡片列表 */
.list {
  flex: 1;
  padding: 0 32rpx 120rpx;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  line-height: 1.4;
  flex: 1;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.05);
  flex-shrink: 0;
}

.status-badge-new { background: rgba(99,102,241,0.1); }
.status-badge-in_progress { background: rgba(245,158,11,0.1); }
.status-badge-done { background: rgba(34,197,94,0.1); }
.status-badge-archived { background: rgba(142,142,147,0.1); }

.status-text { font-size: 22rpx; font-weight: 600; }

.card-content {
  display: block;
  font-size: 26rpx;
  color: #6C6C70;
  line-height: 1.6;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tags { display: flex; gap: 8rpx; flex-wrap: wrap; flex: 1; }

.tag {
  font-size: 22rpx;
  color: #8E8E93;
}

.card-time {
  font-size: 22rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}

/* FAB */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #1C1C1E;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}

.fab-icon {
  font-size: 64rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}
