<!--subpackages/flash/pages/index/index.wxml-->
<view class="container">

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input"
             placeholder="搜索标题或内容"
             placeholder-style="color:#C7C7CC"
             value="{{query}}"
             bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 状态 tab -->
  <scroll-view class="tab-bar" scroll-x>
    <view wx:for="{{tabs}}" wx:key="value"
          class="tab {{activeStatus === item.value ? 'tab-active' : ''}}"
          bindtap="onStatusTab" data-status="{{item.value}}">
      <text class="tab-text">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 卡片列表 -->
  <scroll-view class="list" scroll-y>
    <!-- 空态 -->
    <view wx:if="{{isEmpty}}" class="empty">
      <text class="empty-icon">⚡</text>
      <text class="empty-title">还没有灵感</text>
      <text class="empty-desc">点击右下角的按钮，记录第一个想法</text>
    </view>

    <view wx:else>
      <view wx:for="{{cards}}" wx:key="id"
            class="card"
            bindtap="goDetail" data-id="{{item.id}}">
        <view class="card-header">
          <text class="card-title">{{item.title}}</text>
          <view class="status-badge status-badge-{{item.status}}">
            <text class="status-text" style="color:{{item.statusColor}}">{{item.statusLabel}}</text>
          </view>
        </view>
        <text wx:if="{{item.content}}" class="card-content">{{item.content}}</text>
        <view class="card-footer">
          <view wx:if="{{item.tags.length}}" class="tags">
            <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag"># {{tag}}</text>
          </view>
          <text class="card-time">{{item.relTimeStr}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 新建悬浮按钮 -->
  <view class="fab" bindtap="goAdd">
    <text class="fab-icon">+</text>
  </view>

</view>
