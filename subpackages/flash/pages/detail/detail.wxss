/* subpackages/flash/pages/detail/detail.wxss */
page { background: #F2EBDD; }

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F2EBDD;
}

/* ── top bar ── */
.detail-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 8rpx;
  flex-shrink: 0;
}

.topbar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(60,40,16,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.topbar-back-icon {
  font-size: 56rpx;
  color: #5C5247;
  line-height: 1;
  margin-top: -4rpx;
}

.topbar-more-icon {
  font-size: 28rpx;
  color: #5C5247;
  letter-spacing: 2rpx;
  line-height: 1;
}

/* ── scrollable content ── */
.detail-scroll {
  flex: 1;
  padding: 24rpx 44rpx 0;
}

/* ── status pill banner ── */
.status-pill-banner {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 22rpx 8rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
}

.spb-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
}

.spb-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
}

/* ── title & content ── */
.detail-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #2B241B;
  line-height: 1.22;
  letter-spacing: -0.8rpx;
  margin-bottom: 28rpx;
}

.detail-content {
  display: block;
  font-size: 32rpx;
  color: #5C5247;
  line-height: 1.65;
  letter-spacing: 0.2rpx;
  margin-bottom: 48rpx;
}

/* ── tags ── */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 44rpx;
}

.detail-tag {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.detail-tag-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* ── lifecycle card ── */
.lifecycle-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(60,40,16,0.06);
  box-shadow: 0 1rpx 0 rgba(60,40,16,0.04), 0 4rpx 14rpx rgba(60,40,16,0.05);
  margin-bottom: 40rpx;
}

.lifecycle-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.lifecycle-title-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #897C6C;
  letter-spacing: 3.2rpx;
}

.lifecycle-sub-text {
  font-size: 22rpx;
  color: #B5A993;
}

/* ribbon track */
.ribbon-wrap {
  position: relative;
  height: 112rpx;
}

.ribbon-bg-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 24rpx;
  height: 4rpx;
  background: rgba(60,40,16,0.08);
  border-radius: 2rpx;
}

.ribbon-fill-line {
  position: absolute;
  left: 0;
  top: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.ribbon-nodes {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: space-between;
}

.ribbon-node-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.ribbon-node-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(60,40,16,0.12);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ribbon-node-current {
  width: 56rpx;
  height: 56rpx;
  margin-top: -4rpx;
}

.ribbon-check {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.ribbon-current-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #fff;
}

.ribbon-node-label {
  font-size: 24rpx;
  font-weight: 600;
}

.ribbon-node-desc {
  font-size: 20rpx;
}

/* advance CTA */
.lifecycle-cta {
  margin-top: 32rpx;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background: #EEE6D5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lifecycle-cta-label {
  font-size: 24rpx;
  color: #5C5247;
}

.lifecycle-cta-btn {
  font-size: 24rpx;
  font-weight: 600;
}

/* ── metadata row ── */
.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(60,40,16,0.08);
  margin-bottom: 8rpx;
}

.meta-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-col-right {
  align-items: flex-end;
}

.meta-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #897C6C;
  letter-spacing: 2.4rpx;
}

.meta-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B241B;
}

/* ── bottom action bar ── */
.detail-bar {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 44rpx 64rpx;
  background: linear-gradient(to bottom, transparent, #F2EBDD 28%);
  flex-shrink: 0;
}

.detail-edit-btn {
  flex: 1;
  background: #1E1812;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(60,40,16,0.18);
}

.detail-edit-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.detail-more-btn {
  width: 112rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid rgba(60,40,16,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-more-icon {
  font-size: 28rpx;
  color: #5C5247;
  letter-spacing: 2rpx;
}
