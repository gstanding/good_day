/* subpackages/flash/pages/detail/detail.wxss */
page { background: #F4F4F6; }

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-area {
  flex: 1;
  padding: 32rpx 32rpx 40rpx;
}

/* 标题区 */
.hero-section {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 20rpx;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.status-badge-new { background: rgba(99,102,241,0.1); }
.status-badge-in_progress { background: rgba(245,158,11,0.1); }
.status-badge-done { background: rgba(34,197,94,0.1); }
.status-badge-archived { background: rgba(142,142,147,0.1); }

.status-badge-text { font-size: 24rpx; font-weight: 600; }

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.3;
  margin-bottom: 20rpx;
}

.hero-content {
  display: block;
  font-size: 30rpx;
  color: #3C3C43;
  line-height: 1.7;
}

/* 标签 */
.tags-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 26rpx;
  color: #6366F1;
  background: rgba(99,102,241,0.1);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 时间信息 */
.meta-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 36rpx;
  margin-bottom: 20rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.meta-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.meta-value {
  font-size: 26rpx;
  color: #3C3C43;
}

/* 状态区 */
.status-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 24rpx;
}

.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-option {
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.05);
}

.status-option-active { }

.status-option-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 60rpx;
  background: #F4F4F6;
  flex-shrink: 0;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-edit { background: #1C1C1E; }
.action-delete { background: rgba(255,59,48,0.1); }

.action-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.action-delete-text { color: #FF3B30; }
