<!--subpackages/timecapsule/pages/plog/plog.wxml-->

<!-- Empty state -->
<view wx:if="{{isEmpty}}" class="empty-container">
  <text class="empty-icon">○</text>
  <text class="empty-text">该范围内暂无胶囊</text>
  <text class="empty-hint">试试扩大范围或选择其他位置</text>
</view>

<!-- Cinema player -->
<view wx:else class="cinema">

  <!-- Crossfade background layers, one per capsule -->
  <block wx:for="{{capsules}}" wx:key="id">
    <view class="bg-layer {{currentIndex === index ? 'bg-active' : ''}}">
      <image wx:if="{{item.imagePath}}"
             src="{{item.imagePath}}"
             mode="aspectFill"
             class="bg-photo {{currentIndex === index ? 'bg-photo-active' : ''}}" />
      <view wx:else class="bg-grad" style="background: {{item.bgGradient}};" />
    </view>
  </block>

  <!-- Gradient overlays -->
  <view class="vignette" />
  <view class="bottom-grad" />

  <!-- Story progress bars (top) -->
  <view class="story-bars">
    <block wx:for="{{capsules}}" wx:key="id">
      <view class="bar-track">
        <view class="bar-fill"
              style="width: {{currentIndex > index ? 100 : (currentIndex === index ? progress : 0)}}%;">
        </view>
      </view>
    </block>
  </view>

  <!-- Mini-map (top right) -->
  <view class="mini-map-wrap">
    <canvas type="2d" id="mini-map-canvas" class="mini-map-canvas" />
  </view>

  <!-- Spinning tape (center) -->
  <view class="tape-section" wx:if="{{currentCapsule}}">
    <view class="tape-disc {{isPlaying ? 'tape-spinning' : ''}}">
      <view class="tape-ring tape-ring-1" />
      <view class="tape-ring tape-ring-2" />
      <view class="tape-ring tape-ring-3" />
      <view wx:for="{{tickAngles}}" wx:key="index"
            class="tape-tick {{index === 0 ? 'tape-tick-major' : ''}}"
            style="transform: rotate({{item}}deg);" />
    </view>
    <view class="tape-center-info">
      <text class="tape-time">{{currentCapsule.timeOnly}}</text>
      <text class="tape-counter">{{currentCapsule.indexLabel}} / {{totalLabel}}</text>
    </view>
  </view>

  <!-- Bottom content -->
  <view class="bottom-content" wx:if="{{currentCapsule}}">
    <text class="cap-date">{{currentCapsule.capDateLabel}}</text>
    <text class="cap-title">{{currentCapsule.title}}</text>
    <text class="cap-desc" wx:if="{{currentCapsule.description}}">{{currentCapsule.description}}</text>

    <!-- Waveform -->
    <view class="waveform">
      <view wx:for="{{waveformBars}}" wx:key="index"
            class="wave-bar {{isPlaying ? 'wave-playing' : ''}}"
            style="height: {{item.h}}rpx; animation-delay: {{item.delay}}s;">
      </view>
    </view>

    <!-- Playback controls -->
    <view class="controls">
      <view class="ctrl-side" bindtap="prevCapsule">
        <view class="arrow-prev" />
      </view>
      <view class="ctrl-main" bindtap="togglePlay">
        <view wx:if="{{!isPlaying}}" class="icon-play" />
        <view wx:else class="icon-pause">
          <view class="pause-bar" />
          <view class="pause-bar" />
        </view>
      </view>
      <view class="ctrl-side" bindtap="nextCapsule">
        <view class="arrow-next" />
      </view>
    </view>

    <text class="auto-hint">{{isPlaying ? '自动播放中 · 点击暂停' : '已暂停 · 点击继续'}}</text>
    <view class="plog-share-row">
      <text class="plog-share-text" bindtap="shareToOA">发布到公众号</text>
      <text class="plog-share-dot">·</text>
      <text class="plog-share-text" bindtap="sharePoster">生成旅程海报</text>
    </view>
  </view>

</view>

<!-- Off-screen canvas for poster rendering -->
<canvas type="2d" id="poster-canvas"
        style="position:fixed;left:-400px;top:0;width:375px;height:667px;pointer-events:none;" />
