/* subpackages/timecapsule/pages/plog/plog.wxss — Cinema redesign */

page { background: #000; }

/* ── Empty state ── */
.empty-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0a0a0f;
}
.empty-icon {
  font-size: 80rpx;
  color: rgba(255,255,255,0.2);
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  color: rgba(255,255,255,0.55);
  font-weight: 500;
  margin-bottom: 12rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: rgba(255,255,255,0.3);
}

/* ── Cinema root ── */
.cinema {
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #000;
}

/* ── Crossfade background layers ── */
.bg-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  transition: opacity 1.4s ease;
  overflow: hidden;
}
.bg-active {
  opacity: 1;
}

/* Photo image — Ken-Burns slow zoom when active */
.bg-photo {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  transform: scale(1);
  transition: transform 5.4s ease-out;
}
.bg-photo-active {
  transform: scale(1.06);
}

/* Gradient fallback */
.bg-grad {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}

/* ── Gradient overlays ── */
.vignette {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at center, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.85) 100%);
  z-index: 1;
}
.bottom-grad {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 65%;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.95) 80%);
  z-index: 1;
}

/* ── Story bars ── */
.story-bars {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  display: flex;
  gap: 6rpx;
}
.bar-track {
  flex: 1;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(255,255,255,0.28);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 2rpx;
  transition: width 0.3s linear;
}

/* ── Mini-map ── */
.mini-map-wrap {
  position: absolute;
  top: 50rpx;
  right: 24rpx;
  width: 140rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.22);
  z-index: 20;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.55);
}
.mini-map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* ── Spinning tape ── */
.tape-section {
  position: absolute;
  top: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  width: 300rpx;
  height: 300rpx;
}

.tape-disc {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(0,0,0,0.38);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,0.18);
  box-shadow:
    0 0 0 22rpx rgba(255,255,255,0.04),
    0 0 0 44rpx rgba(255,255,255,0.025),
    0 0 0 66rpx rgba(255,255,255,0.01);
  animation: tapeSpin 12s linear infinite;
}
.tape-spinning {
  animation-duration: 4s;
}

@keyframes tapeSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.tape-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.08);
}

/* ── Tick marks (clock-face spokes inside disc) ── */
.tape-tick {
  position: absolute;
  top: 22rpx;
  left: 148rpx;
  width: 4rpx;
  height: 14rpx;
  background: rgba(255,255,255,0.28);
  transform-origin: 2rpx 128rpx;
  border-radius: 2rpx;
}
.tape-tick-major {
  height: 24rpx;
  background: rgba(255,255,255,0.8);
}
.tape-ring-1 { top: 28rpx; left: 28rpx; right: 28rpx; bottom: 28rpx; }
.tape-ring-2 { top: 60rpx; left: 60rpx; right: 60rpx; bottom: 60rpx; }
.tape-ring-3 { top: 90rpx; left: 90rpx; right: 90rpx; bottom: 90rpx; }

.tape-center-info {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.tape-time {
  font-size: 68rpx;
  font-weight: 200;
  color: #fff;
  letter-spacing: -2rpx;
  line-height: 1;
}
.tape-counter {
  font-size: 20rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 4rpx;
  font-weight: 600;
}

/* ── Bottom content ── */
.bottom-content {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 10;
  padding: 0 48rpx 64rpx;
}
.cap-date {
  display: block;
  font-size: 24rpx;
  color: #FF6B6B;
  letter-spacing: 2rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.cap-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -1rpx;
  line-height: 1.2;
  margin-bottom: 14rpx;
}
.cap-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.62);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* ── Waveform ── */
.waveform {
  display: flex;
  align-items: center;
  gap: 5rpx;
  height: 64rpx;
  margin-bottom: 40rpx;
}
.wave-bar {
  flex: 1;
  background: rgba(255,255,255,0.55);
  border-radius: 3rpx;
  min-height: 6rpx;
  animation: waveAnim 1.3s ease-in-out infinite alternate;
  animation-play-state: paused;
}
.wave-playing {
  animation-play-state: running;
}
@keyframes waveAnim {
  0%   { transform: scaleY(0.45); opacity: 0.65; }
  100% { transform: scaleY(1.1);  opacity: 1; }
}

/* ── Playback controls ── */
.controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ctrl-side {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ctrl-main {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255,255,255,0.22);
}

/* Arrow icons */
.arrow-prev {
  width: 0; height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-right: 28rpx solid #fff;
  margin-right: 4rpx;
}
.arrow-next {
  width: 0; height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 28rpx solid #fff;
  margin-left: 4rpx;
}

/* Play icon */
.icon-play {
  width: 0; height: 0;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-left: 36rpx solid #000;
  margin-left: 8rpx;
}

/* Pause icon */
.icon-pause {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pause-bar {
  width: 9rpx;
  height: 38rpx;
  background: #000;
  border-radius: 4rpx;
}

.auto-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.38);
  letter-spacing: 1rpx;
}

.plog-share-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 24rpx;
}

.plog-share-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  border-bottom: 1rpx solid rgba(255,255,255,0.2);
  padding-bottom: 2rpx;
}

.plog-share-dot {
  font-size: 22rpx;
  color: rgba(255,255,255,0.2);
  padding: 0 16rpx;
}
