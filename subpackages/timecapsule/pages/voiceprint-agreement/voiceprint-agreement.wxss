/* subpackages/timecapsule/pages/voiceprint-agreement/voiceprint-agreement.wxss */
page {
  overflow-x: hidden;
}

.page-root {
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

.agreement-scroll {
  width: 100%;
  box-sizing: border-box;
  flex: 1;
  padding: 32rpx;
}

.agreement-header {
  margin-bottom: 32rpx;
}

.agreement-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.agreement-meta {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.agreement-body {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

.agreement-footer {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.check-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.check-label {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-reject {
  flex: 1;
  background: #f2f2f2;
  color: #666;
  font-size: 28rpx;
}

.btn-agree {
  flex: 1;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
}

.btn-agree.disabled {
  background: #9ed8b6;
}
