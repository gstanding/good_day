<!--subpackages/timecapsule/pages/map/map.wxml-->
<view class="container">
  <map id="myMap" 
       class="map" 
       latitude="{{latitude}}" 
       longitude="{{longitude}}" 
       markers="{{markers}}" 
       show-location 
       bindmarkertap="onMarkerTap"></map>

  <view class="controls">
    <view class="btn-record" bindtap="goRecord">
      <view class="record-icon"></view>
      <text>埋下胶囊</text>
    </view>
    
    <view class="location-status" bindtap="updateLocation">
      <text>{{statusText}}</text>
    </view>
  </view>
</view>
