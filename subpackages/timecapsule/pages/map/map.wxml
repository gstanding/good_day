<!--subpackages/timecapsule/pages/map/map.wxml-->
<view class="container">
  <map id="myMap"
       class="map"
       latitude="{{latitude}}"
       longitude="{{longitude}}"
       markers="{{markers}}"
       circles="{{circles}}"
       show-location
       bindmarkertap="onMarkerTap"></map>

  <view class="controls">
    <view class="btn-record" bindtap="goRecord">
      <view class="record-icon"></view>
      <text>埋下胶囊</text>
    </view>

    <view class="location-status" bindtap="updateLocation">
      <text>{{statusText}}</text>
    </view>
  </view>

  <view class="plog-panel" wx:if="{{showPlogPanel}}">
    <text class="plog-panel-title">生成旅行记录</text>
    <text class="plog-center-label" wx:if="{{plogCenterTitle}}">以「{{plogCenterTitle}}」为中心</text>
    <view class="plog-radius-row">
      <text class="plog-panel-hint">范围</text>
      <text class="plog-radius-label">{{plogRadiusLabel}}</text>
    </view>
    <slider class="plog-slider"
            min="0" max="100" step="1"
            value="{{sliderValue}}"
            activeColor="#4a90e2"
            block-size="20"
            bindchanging="onRadiusChange"
            bindchange="onRadiusChange" />
    <view class="plog-panel-actions">
      <button class="btn-cancel-plog" bindtap="closePlogPanel">取消</button>
      <button class="btn-go-plog" bindtap="goPlog">生成记录</button>
    </view>
  </view>
</view>
