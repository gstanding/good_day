/* subpackages/timecapsule/pages/map/map.wxss */
.container {
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.controls {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none; /* Let clicks pass through to map if needed, but buttons need events */
}

.btn-record {
  pointer-events: auto;
  width: 140rpx;
  height: 140rpx;
  background: #ff4d4f;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 77, 79, 0.4);
  margin-bottom: 30rpx;
}

.record-icon {
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.location-status {
  pointer-events: auto;
  background: rgba(255, 255, 255, 0.9);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}
