/* subpackages/timecapsule/pages/record/record.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #2c3e50;
  color: #fff;
}

.timer {
  font-size: 80rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  font-variant-numeric: tabular-nums;
}

.status {
  font-size: 28rpx;
  color: #ccc;
  margin-bottom: 100rpx;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 40rpx;
}

.btn-record {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.btn-record.recording {
  transform: scale(1.2);
  background: #ff4d4f;
}

.mic-icon {
  width: 40rpx;
  height: 60rpx;
  background: #2c3e50;
  border-radius: 20rpx;
}

.btn-cancel {
  color: #fff;
  padding: 20rpx;
  margin-right: 40rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
}

.form-area {
  width: 80%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.input-title {
  background: rgba(255, 255, 255, 0.1);
  padding: 20rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 32rpx;
}

.input-desc {
  background: rgba(255, 255, 255, 0.1);
  padding: 20rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 28rpx;
  height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.form-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-discard {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 28rpx;
}

.btn-save {
  flex: 1;
  background: #ff4d4f;
  color: #fff;
  font-size: 28rpx;
}
