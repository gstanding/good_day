<!--pages/home/home.wxml-->
<view class="root" style="background:{{t.pageBg}}">
  <scroll-view class="scroller" scroll-y>

    <!-- ── Header ── -->
    <view class="header-row">
      <view>
        <text class="title" style="color:{{t.text}}; font-weight:{{t.dark?800:700}}">工具集</text>
        <text class="subtitle" style="color:{{t.textMuted}}">{{t.subtitle}}</text>
      </view>
      <view class="theme-btn" style="background:{{t.btnBg}}; border-color:{{t.btnBorder}}" bindtap="openPicker">
        <view class="swatch-ring">
          <view class="swatch-seg" style="background:{{t.swatch0}}"></view>
          <view class="swatch-seg" style="background:{{t.swatch1}}"></view>
          <view class="swatch-seg" style="background:{{t.swatch2}}"></view>
        </view>
        <text class="theme-name" style="color:{{t.text}}">{{t.name}}</text>
      </view>
    </view>

    <!-- ── Hero card ── -->
    <view class="hero {{annImagePath ? 'hero-with-photo' : ''}}" style="{{annImagePath ? '' : 'background:' + t.heroBg + ';'}} box-shadow:{{t.heroShadow}}" bindtap="goHero">
      <image wx:if="{{annImagePath}}" class="hero-bg-image" src="{{annImagePath}}" mode="aspectFill" />
      <view wx:if="{{annImagePath}}" class="hero-bg-dim"></view>
      <view class="hero-circle"></view>
      <view class="hero-content">
        <view class="hero-eyebrow">
          <view class="hero-dot" style="background:{{annImagePath ? '#fff' : t.heroAccent}}"></view>
          <text class="hero-eyebrow-text" style="color:{{annImagePath ? '#fff' : t.heroText}}">下一个纪念日</text>
        </view>
        <block wx:if="{{hasAnniversary}}">
          <text class="hero-title" style="color:{{annImagePath ? '#fff' : t.heroText}}">{{heroTitle}}</text>
          <view class="hero-count-row">
            <block wx:if="{{heroDays === 0}}">
              <text class="hero-today" style="color:{{annImagePath ? '#fff' : t.heroAccent}}">就是今天</text>
            </block>
            <block wx:else>
              <text class="hero-days" style="color:{{annImagePath ? '#fff' : t.heroText}}">{{heroDays}}</text>
              <text class="hero-date-label" style="color:{{annImagePath ? 'rgba(255,255,255,0.8)' : t.heroMuted}}">天后 · {{heroDate}}</text>
            </block>
          </view>
        </block>
        <block wx:else>
          <text class="hero-title" style="color:{{annImagePath ? '#fff' : t.heroText}}">去记录一个重要时刻</text>
          <view class="hero-count-row">
            <text class="hero-empty" style="color:{{annImagePath ? 'rgba(255,255,255,0.8)' : t.heroMuted}}">点击进入纪念日 →</text>
          </view>
        </block>
      </view>
    </view>

    <!-- ── 今日灵感 widget ── -->
    <view wx:if="{{flashCard}}" class="flash-widget" bindtap="goFlashCard"
          style="background:{{t.card}}; box-shadow:{{t.cardShadow}}; border:{{t.cardBorder}}">
      <view class="flash-widget-header">
        <text class="flash-widget-eyebrow" style="color:{{t.sectionLabel}}">今日灵感</text>
        <view class="flash-status-badge flash-status-{{flashCard.status}}">
          <text class="flash-status-text" style="color:{{flashCard.statusColor}}">{{flashCard.statusLabel}}</text>
        </view>
      </view>
      <text class="flash-widget-title" style="color:{{t.text}}">{{flashCard.title}}</text>
      <text wx:if="{{flashCard.content}}" class="flash-widget-content" style="color:{{t.textMuted}}">{{flashCard.content}}</text>
      <view wx:if="{{flashCard.tags.length}}" class="flash-tags">
        <text wx:for="{{flashCard.tags}}" wx:key="*this" class="flash-tag" style="color:{{t.textDim}}"># {{item}}</text>
      </view>
    </view>

    <!-- ── 常用工具 ── -->
    <text class="section-label" style="color:{{t.sectionLabel}}">常用工具</text>
    <view class="tools-group" style="background:{{t.card}}; box-shadow:{{t.cardShadow}}; border:{{t.cardBorder}}">

      <view class="tool-row" bindtap="goAnniversary">
        <view class="icon-ann">
          <view class="icon-ann-top"><text class="icon-ann-month">AUG</text></view>
          <view class="icon-ann-bottom"><text class="icon-ann-num">17</text></view>
        </view>
        <view class="tool-info">
          <view class="tool-name-row">
            <text class="tool-name" style="color:{{t.text}}">纪念日</text>
            <text wx:if="{{annMeta}}" class="tool-meta" style="color:{{t.textDim}}">{{annMeta}}</text>
          </view>
          <text class="tool-desc" style="color:{{t.textMuted}}">记录重要时刻，倒数美好未来</text>
        </view>
        <view class="chevron" style="border-color:{{t.chevron}}"></view>
      </view>

      <view class="divider" style="background:{{t.divider}}"></view>

      <view class="tool-row" bindtap="goCapsule">
        <view class="icon-voice">
          <text class="icon-voice-mic">🎙</text>
        </view>
        <view class="tool-info">
          <view class="tool-name-row">
            <text class="tool-name" style="color:{{t.text}}">声音胶囊</text>
            <text wx:if="{{capMeta}}" class="tool-meta" style="color:{{t.textDim}}">{{capMeta}}</text>
          </view>
          <text class="tool-desc" style="color:{{t.textMuted}}">在时空里埋下你的声音</text>
        </view>
        <view class="chevron" style="border-color:{{t.chevron}}"></view>
      </view>

      <view class="divider" style="background:{{t.divider}}"></view>

      <view class="tool-row" bindtap="goFlash">
        <view class="icon-flash">
          <text class="icon-flash-emoji">⚡</text>
        </view>
        <view class="tool-info">
          <view class="tool-name-row">
            <text class="tool-name" style="color:{{t.text}}">闪念胶囊</text>
            <text wx:if="{{flashMeta}}" class="tool-meta" style="color:{{t.textDim}}">{{flashMeta}}</text>
          </view>
          <text class="tool-desc" style="color:{{t.textMuted}}">捕捉灵感，跟踪想法的成长</text>
        </view>
        <view class="chevron" style="border-color:{{t.chevron}}"></view>
      </view>

    </view>

    <!-- ── 即将推出 ── -->
    <text class="section-label" style="color:{{t.sectionLabel}}">即将推出</text>
    <view class="coming-row" style="background:{{t.comingBg}}; border-color:{{t.comingBorderColor}}">
      <view class="icon-coming" style="background:{{t.iconComingBg}}">
        <text class="icon-coming-plus" style="color:{{t.iconComingPlus}}">+</text>
      </view>
      <view class="tool-info">
        <text class="tool-name" style="color:{{t.textMuted}}; font-weight:600">更多工具开发中</text>
        <text class="tool-desc" style="color:{{t.textDim}}">有想法？留言告诉我</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

  <!-- ── Overlay mask ── -->
  <view class="mask {{pickerOpen ? 'mask-open' : ''}}" bindtap="closePicker"></view>

  <!-- ── Theme picker sheet ── -->
  <view class="sheet {{pickerOpen ? 'sheet-open' : ''}}" style="background:{{t.sheetBg}}">
    <view class="sheet-handle" style="background:{{t.handle}}"></view>
    <text class="sheet-title" style="color:{{t.sheetText}}">选择主题</text>
    <text class="sheet-sub" style="color:{{t.sheetSec}}">点击即刻应用，设置会自动保存</text>

    <view class="theme-grid">
      <view wx:for="{{themes}}" wx:key="key"
            class="theme-card"
            style="background:{{t.themeCardBg}}; border-color:{{item.key === themeKey ? '#0B85FF' : (t.dark ? 'rgba(255,255,255,0.1)' : 'rgba(60,60,67,0.12)')}}"
            bindtap="selectTheme" data-key="{{item.key}}">
        <view class="theme-preview" style="background:{{item.swatch0}}">
          <view class="preview-bar1" style="background:{{item.swatch2}}"></view>
          <view class="preview-bar2" style="background:{{item.swatch2}}"></view>
          <view class="preview-rect1" style="background:{{item.swatch1}}"></view>
          <view class="preview-rect2" style="background:{{item.swatch1}}"></view>
        </view>
        <view class="theme-label-row">
          <view>
            <text class="theme-label-name" style="color:{{t.sheetText}}">{{item.name}}</text>
            <text class="theme-label-hint" style="color:{{t.sheetSec}}">{{item.hint}}</text>
          </view>
          <view wx:if="{{item.key === themeKey}}" class="check-circle">
            <text class="check-mark">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
